# Supabase (public values: safe in the browser)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Supabase secret (server only). Needed by the signed-in dashboard's server functions.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (server only). Without a key, /agente uses labelled local text and PDF extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: require a code before spending Gemini quota on the public demo.
DEMO_ACCESS_CODE=
